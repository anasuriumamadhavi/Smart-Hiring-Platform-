# Example environment variables for Smart Hiring Platform
# Do NOT put real secrets here. Copy to `.env` or Vercel project variables.

# Database (Postgres) - set either DATABASE_URL (single connection string) or the components below
# Example DATABASE_URL: postgres://user:password@host:5432/dbname
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# JWT / auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://your-deployment-url.vercel.app

# Node
NODE_ENV=production
PORT=3000

# Optional third-party services
# S3 or compatible storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# OAuth providers (examples)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

